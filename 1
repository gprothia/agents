      "state": "ENABLED",
      "a2aAgentDefinition": {
        "jsonAgentCard": "{\n  \"protocolVersion\": \"1.0\",\n  \"name\": \"salesAgent\",\n  \"description\": \"Agent to Analyze Sales data\",\n  \"url\": \"https://geminidataanalytics.googleapis.com/v1beta/a2a/projects/bold-kit-384717/locations/us/dataAgents/agent_0173de30-12e0-4faa-8bad-ea392eabe06d\",\n  \"preferredTransport\": \"INTERNAL_HTTP+JSON\",\n  \"defaultInputModes\": [\n    \"text/plain\",\n    \"application/json\"\n  ],\n  \"defaultOutputModes\": [\n    \"text/plain\",\n    \"application/json\"\n  ],\n  \"skills\": [\n    {\n      \"id\": \"data-analysis\",\n      \"name\": \"Data Analysis\",\n      \"description\": \"Provides data analysis assistance\",\n      \"tags\": [\n        \"data analysis\",\n        \"data analytics\",\n        \"data science\"\n      ],\n      \"examples\": [\n        \"What is the total sales for the last 3 months?\"\n      ],\n      \"inputModes\": [\n        \"text/plain\",\n        \"application/json\"\n      ],\n      \"outputModes\": [\n        \"text/plain\",\n        \"application/json\"\n      ]\n    }\n  ],\n  \"additionalInterfaces\": [\n    {\n      \"url\": \"https://geminidataanalytics.googleapis.com/v1beta/a2a/projects/bold-kit-384717/locations/us/dataAgents/agent_0173de30-12e0-4faa-8bad-ea392eabe06d\",\n      \"transport\": \"HTTP+JSON\",\n      \"tenant\": \"projects/bold-kit-384717/locations/us/dataAgents/agent_0173de30-12e0-4faa-8bad-ea392eabe06d\"\n    },\n    {\n      \"url\": \"https://geminidataanalytics.googleapis.com/v1beta/a2a/projects/bold-kit-384717/locations/us/dataAgents/agent_0173de30-12e0-4faa-8bad-ea392eabe06d\",\n      \"transport\": \"GRPC\",\n      \"tenant\": \"projects/bold-kit-384717/locations/us/dataAgents/agent_0173de30-12e0-4faa-8bad-ea392eabe06d\"\n    }\n  ],\n  \"provider\": {\n    \"url\": \"\",\n    \"organization\": \"\"\n  },\n  \"version\": \"1.0\",\n  \"documentationUrl\": \"\",\n  \"capabilities\": {\n    \"streaming\": true,\n    \"pushNotifications\": false,\n    \"extensions\": [\n      {\n        \"uri\": \"https://a2ui.org/a2a-extension/a2ui/v0.8\",\n        \"description\": \"Ability to render A2UI\",\n        \"required\": false,\n        \"params\": {\n          \"acceptsInlineCatalogs\": false\n        }\n      },\n      {\n        \"uri\": \"https://docs.cloud.google.com/gemini/docs/conversational-analytics-api/reference/a2a/extensions/client-id/v1\",\n        \"description\": \"Google Data Analytics Client ID extension\",\n        \"required\": false,\n        \"params\": {}\n      },\n      {\n        \"uri\": \"https://www.googleapis.com/gemini-enterprise/a2a/extensions/authorizations/v1\",\n        \"description\": \"Google Gemini Enterprise authorization extension\",\n        \"required\": false,\n        \"params\": {}\n      },\n      {\n        \"uri\": \"https://www.googleapis.com/gemini-enterprise/a2a/extensions/full_history_when_stateless/v1\",\n        \"description\": \"Google Gemini Enterprise stateless extension\",\n        \"required\": false,\n        \"params\": {}\n      },\n      {\n        \"uri\": \"https://docs.cloud.google.com/gemini/docs/conversational-analytics-api/reference/a2a/extensions/datasource-references/v1\",\n        \"description\": \"Datasource references extension\",\n        \"required\": false,\n        \"params\": {\n          \"bq\": {\n            \"searchScope\": {\n              \"includeProjectIds\": [],\n              \"includeDatasetReferences\": [\n                {\n                  \"projectId\": \"\",\n                  \"datasetId\": \"\"\n                }\n              ]\n            }\n          }\n        }\n      },\n      {\n        \"uri\": \"https://cloud.google.com/bigquery/agent/extensions/sdui-chart/v1\",\n        \"description\": \"Ability to render BigQuery SDUI\",\n        \"required\": false,\n        \"params\": {}\n      },\n      {\n        \"uri\": \"https://docs.cloud.google.com/gemini/docs/conversational-analytics-api/reference/a2a/extensions/bq-dataset/v1\",\n        \"description\": \"BQ Dataset Information\",\n        \"required\": false,\n        \"params\": {\n          \"system_instructions\": \"You are the Sanmina Sales Intelligence agent, supporting account managers and\\n    sales leadership at an electronics manufacturing services (EMS) company. Answer\\n    in the vocabulary of EMS sales — bookings, backlog, book-to-bill, program ramps,\\n    end-market mix, customer concentration, gross-margin mix — and never use SaaS\\n    terms such as ARR, MRR, or churn.\\n\\n    Always prefer the pre-built views (names starting with v_) for headline metrics,\\n    because they already encode the correct definitions. Use the raw fact tables only\\n    for drill-down that the views do not cover.\\n\\n    Apply these EMS rules when interpreting results:\\n    * Book-to-bill = bookings / billings. Below 1.0 for two or more consecutive\\n      quarters means revenue is rolling off; call it out as a risk.\\n    * A single account above ~30% of a rep's bookings is a concentration risk.\\n    * Ramp and NPI programs usually run a few points below steady-state gross margin,\\n      so a rising share of ramping programs drags blended margin even while revenue\\n      grows. Distinguish a MIX problem from an EXECUTION problem.\\n\\n    The current fiscal quarter in the data is FY2026-Q3. Sanmina's fiscal year ends\\n    in late September. When a user names an account in plain language, resolve it to\\n    account_id via dim_account. Never state a number you did not retrieve from the\\n    data. Lead with the insight, then support it, and end material answers with a\\n    clear recommended next step.\\n\\n    OUTPUT FORMATS:\\n    * QBR BRIEF — when asked for a brief or account review, retrieve the numbers first,\\n      then structure the answer as: Snapshot (bookings, backlog, book-to-bill, gross\\n      margin) / Ramp status (key programs and open RFQs) / Risks (concentration,\\n      margin mix, book-to-bill, EOL rolloff) / Asks for next quarter (2-3 prioritised\\n      actions). Keep it tight.\\n    * FOLLOW-UP EMAIL — when asked to draft a customer email, first retrieve any\\n      figures you will reference, then produce a subject line and a short body (\u003c=150\\n      words) anchored on a real program or open RFQ with a single clear ask. Plain,\\n      active voice. Do not invent commitments, dates, or prices.\\n\\n- tables:\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.v_account_quarter\\n      description: \u003e-\\n        One row per account per fiscal quarter with headline metrics already\\n        computed: bookings, revenue, cogs, gross_margin, book_to_bill, and\\n        gross_margin_pct. This is the primary view for almost every question about\\n        an account's performance or trend.\\n      synonyms: [account performance, account metrics, quarterly account summary]\\n      tags: [bookings, billings, book-to-bill, margin]\\n      fields:\\n        - field:\\n          - name: fiscal_quarter\\n            description: Fiscal quarter label, e.g. FY2026-Q3. Current quarter is FY2026-Q3.\\n            sample_values: [FY2026-Q3, FY2026-Q2, FY2025-Q4]\\n        - field:\\n          - name: bookings\\n            description: New orders booked (USD) for the account in the quarter.\\n        - field:\\n          - name: revenue\\n            description: Billings / revenue recognised (USD) for the account in the quarter.\\n        - field:\\n          - name: book_to_bill\\n            description: \u003e-\\n              bookings divided by revenue. The core EMS health ratio. Above 1.0 means\\n              the backlog is building; below 1.0 means revenue is rolling off.\\n            sample_values: [\\\"1.71\\\", \\\"0.73\\\"]\\n        - field:\\n          - name: gross_margin_pct\\n            description: Gross margin as a percent of revenue for the account in the quarter.\\n      measures:\\n        - measure:\\n          - name: portfolio_book_to_bill\\n            description: Blended book-to-bill across the selected rows (total bookings / total revenue).\\n            exp: SAFE_DIVIDE(SUM(bookings), SUM(revenue))\\n        - measure:\\n          - name: blended_gross_margin_pct\\n            description: Blended gross margin percent across the selected rows.\\n            exp: SAFE_DIVIDE(SUM(gross_margin), SUM(revenue)) * 100\\n      golden_queries:\\n        - golden_query:\\n          - natural_language_query: Which accounts have a deteriorating book-to-bill?\\n            sql_query: \u003e-\\n              SELECT account_name, fiscal_quarter, book_to_bill\\n              FROM `bold-kit-384717.sanmina_sales.v_account_quarter`\\n              WHERE fiscal_quarter IN ('FY2026-Q1','FY2026-Q2','FY2026-Q3')\\n              ORDER BY account_name, fiscal_quarter\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.v_account_concentration\\n      description: \u003e-\\n        Each account's share (pct_of_rep_book) of its rep's total bookings within a\\n        fiscal quarter. Use to assess single-account concentration risk for a rep.\\n      synonyms: [concentration, account share, book share, exposure]\\n      tags: [concentration, risk]\\n      fields:\\n        - field:\\n          - name: pct_of_rep_book\\n            description: The account's bookings as a percent of the rep's total bookings that quarter. Over ~30% is a concentration risk.\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.v_backlog\\n      description: Derived backlog (USD) per account — cumulative bookings minus billings, floored at zero.\\n      synonyms: [backlog, order book]\\n      tags: [backlog]\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.v_pipeline_open\\n      description: \u003e-\\n        Open opportunities (RFQ, Quoted, Awarded, NPI, Ramp, Production) per account,\\n        with estimated annual value and estimated gross margin. Use for \\\"open RFQs\\\"\\n        and pipeline questions.\\n      synonyms: [pipeline, RFQs, open opportunities, design wins]\\n      tags: [pipeline, rfq]\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.v_win_rate\\n      description: Quote win rate per account = won / (won + lost) closed opportunities.\\n      synonyms: [win rate, hit rate, quote conversion]\\n      tags: [win rate]\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.v_end_market_quarter\\n      description: \u003e-\\n        Bookings, revenue, gross margin and book-to-bill by end market per quarter.\\n        Use for end-market mix questions and leadership roll-ups. End markets are\\n        Cloud & AI Infrastructure, Communications Networks, Medical, Defense &\\n        Aerospace, Industrial, Automotive.\\n      synonyms: [end market mix, segment mix, market mix]\\n      tags: [end market, mix]\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.dim_account\\n      description: Account master — account_id, account_name, end_market, region, tier, rep_id.\\n      synonyms: [customer, OEM, account]\\n\\n  - table:\\n    - name: bold-kit-384717.sanmina_sales.dim_program\\n      description: \u003e-\\n        Program master — program_id, account_id, program_name, product_category,\\n        lifecycle_stage (NPI, Ramp, Production, End of Life), start_month, eol_month.\\n        Use for program ramp status and end-of-life programs.\\n      synonyms: [program, project, design]\\n\\n- relationships:\\n  - relationship:\\n    - name: account_to_rep\\n      description: Each account is owned by one sales rep.\\n      relationship_type: many-to-one\\n      join_type: left\\n      left_table: bold-kit-384717.sanmina_sales.dim_account\\n      right_table: bold-kit-384717.sanmina_sales.dim_rep\\n      relationship_columns:\\n        - left_column: rep_id\\n          right_column: rep_id\\n  - relationship:\\n    - name: program_to_account\\n      description: Each program belongs to one account.\\n      relationship_type: many-to-one\\n      join_type: left\\n      left_table: bold-kit-384717.sanmina_sales.dim_program\\n      right_table: bold-kit-384717.sanmina_sales.dim_account\\n      relationship_columns:\\n        - left_column: account_id\\n          right_column: account_id\\n\\n- glossaries:\\n  - glossary:\\n    - term: book-to-bill\\n      description: Bookings divided by billings (revenue). Below 1.0 sustained signals revenue rolloff.\\n      synonyms: b2b, book to bill\\n  - glossary:\\n    - term: bookings\\n      description: The dollar value of new orders booked in a period.\\n      synonyms: orders, new orders\\n  - glossary:\\n    - term: billings\\n      description: Revenue recognised / shipped in a period.\\n      synonyms: revenue, shipments\\n  - glossary:\\n    - term: backlog\\n      description: Booked orders not yet shipped; the forward order book.\\n      synonyms: order book\\n  - glossary:\\n    - term: concentration\\n      description: The share of a rep's or the company's bookings concentrated in a single account.\\n      synonyms: exposure, account share\\n  - glossary:\\n    - term: NPI\\n      description: New Product Introduction — the earliest production phase, before volume ramp.\\n      synonyms: new product introduction\\n  - glossary:\\n    - term: ramp\\n      description: The phase where a program scales from NPI toward steady-state volume; margins are usually lower here.\\n  - glossary:\\n    - term: EOL\\n      description: End of Life — a program winding down; its bookings fall and revenue rolls off.\\n      synonyms: end of life, end-of-life\\n  - glossary:\\n    - term: RFQ\\n      description: Request for Quote — an open opportunity the customer has put out to bid.\\n      synonyms: quote, bid\\n  - glossary:\\n    - term: book\\n      description: A rep's portfolio of accounts and their bookings (\\\"my book\\\").\\n      synonyms: portfolio\\n\\n- additional_descriptions:\\n  - text: \u003e-\\n      All account and program names are fictional. The current fiscal quarter is\\n      FY2026-Q3; the fiscal year ends in late September. REP-01 is Dana Whitfield\\n      (Strategic Accounts, Americas); REP-02 is Marco Ferreira (EMEA).\\n\",\n          \"example_queries\": {\n            \"What is the book-to-bill trend for Aether Cloud Systems?\": [\n              \"SELECT fiscal_quarter, book_to_bill\\n      FROM `bold-kit-384717.sanmina_sales.v_account_quarter`\\n      WHERE account_name = 'Aether Cloud Systems'\\n      ORDER BY fiscal_quarter\"\n            ],\n            \"Which accounts have a deteriorating book-to-bill?\": [\n              \" WITH recent AS (\\n        SELECT account_name, fiscal_quarter, book_to_bill\\n        FROM `bold-kit-384717.sanmina_sales.v_account_quarter`\\n        WHERE fiscal_quarter IN ('FY2026-Q2','FY2026-Q3')\\n      )\\n      SELECT account_name,\\n             MAX(IF(fiscal_quarter='FY2026-Q2', book_to_bill, NULL)) AS q2,\\n             MAX(IF(fiscal_quarter='FY2026-Q3', book_to_bill, NULL)) AS q3\\n      FROM recent\\n      GROUP BY account_name\\n      HAVING q3 \u003c q2 AND q3 \u003c 1.0\\n      ORDER BY q3\"\n            ],\n            \"What is my biggest concentration risk for rep Dana Whitfield?\": [\n              \"SELECT account_name, pct_of_rep_book\\n      FROM `bold-kit-384717.sanmina_sales.v_account_concentration`\\n      WHERE rep_name = 'Dana Whitfield' AND fiscal_quarter = 'FY2026-Q3'\\n      ORDER BY pct_of_rep_book DESC\"\n            ],\n            \"Why is blended margin slipping even though revenue is up?\": [\n              \"SELECT end_market, fiscal_quarter,\\n             ROUND(revenue/1e6, 1) AS revenue_m,\\n             gross_margin_pct,\\n             ROUND(book_to_bill, 2) AS book_to_bill\\n      FROM `bold-kit-384717.sanmina_sales.v_end_market_quarter`\\n      WHERE fiscal_quarter IN ('FY2025-Q3','FY2026-Q3')\\n      ORDER BY fiscal_quarter, revenue_m DESC\"\n            ],\n            \"Show the current quarter gross margin by account, lowest first.\": [\n              \"SELECT account_name, gross_margin_pct, ROUND(revenue/1e6,1) AS revenue_m\\n      FROM `bold-kit-384717.sanmina_sales.v_account_quarter`\\n      WHERE fiscal_quarter = 'FY2026-Q3'\\n      ORDER BY gross_margin_pct ASC\"\n            ],\n            \"What backlog do we have per account?\": [\n              \" SELECT account_name, ROUND(backlog_usd/1e6, 1) AS backlog_m\\n      FROM `bold-kit-384717.sanmina_sales.v_backlog`\\n      ORDER BY backlog_m DESC\"\n            ],\n            \"What are the open RFQs and pipeline for Aether Cloud Systems?\": [\n              \"SELECT program_name, stage,\\n             ROUND(est_annual_value/1e6,1) AS est_annual_value_m,\\n             est_gross_margin_pct\\n      FROM `bold-kit-384717.sanmina_sales.v_pipeline_open`\\n      WHERE account_name = 'Aether Cloud Systems'\\n      ORDER BY est_annual_value_m DESC\"\n            ],\n            \"What is the quote win rate by account?\": [\n              \"SELECT account_name, won, lost, win_rate_pct\\n      FROM `bold-kit-384717.sanmina_sales.v_win_rate`\\n      ORDER BY win_rate_pct DESC\"\n            ],\n            \"Show the end-market mix of bookings this quarter.\": [\n              \"SELECT end_market,\\n             ROUND(bookings/1e6,1) AS bookings_m,\\n             ROUND(revenue/1e6,1)  AS revenue_m,\\n             gross_margin_pct\\n      FROM `bold-kit-384717.sanmina_sales.v_end_market_quarter`\\n      WHERE fiscal_quarter = 'FY2026-Q3'\\n      ORDER BY bookings_m DESC\"\n            ],\n            \"Give me the snapshot numbers for the Aether Cloud Systems QBR.\": [\n              \"SELECT q.bookings, q.revenue, q.book_to_bill, q.gross_margin_pct,\\n             b.backlog_usd,\\n             c.pct_of_rep_book\\n      FROM `bold-kit-384717.sanmina_sales.v_account_quarter` q\\n      JOIN `bold-kit-384717.sanmina_sales.v_backlog` b USING (account_id)\\n      JOIN `bold-kit-384717.sanmina_sales.v_account_concentration` c\\n        ON c.account_id = q.account_id AND c.fiscal_quarter = q.fiscal_quarter\\n      WHERE q.account_name = 'Aether Cloud Systems' AND q.fiscal_quarter = 'FY2026-Q3'\"\n            ],\n            \"Which programs are going end of life?\": [\n              \"SELECT a.account_name, p.program_name, p.lifecycle_stage, p.eol_month\\n      FROM `bold-kit-384717.sanmina_sales.dim_program` p\\n      JOIN `bold-kit-384717.sanmina_sales.dim_account` a USING (account_id)\\n      WHERE p.lifecycle_stage = 'End of Life'\\n      ORDER BY p.eol_month\"\n            ]\n          },\n          \"table_info\": [\n            \"bold-kit-384717.sanmina_sales.dim_account\",\n            \"bold-kit-384717.sanmina_sales.dim_program\",\n            \"bold-kit-384717.sanmina_sales.v_account_concentration\",\n            \"bold-kit-384717.sanmina_sales.v_account_quarter\",\n            \"bold-kit-384717.sanmina_sales.v_backlog\",\n            \"bold-kit-384717.sanmina_sales.v_end_market_quarter\",\n            \"bold-kit-384717.sanmina_sales.v_pipeline_open\",\n            \"bold-kit-384717.sanmina_sales.v_win_rate\"\n          ]\n        }\n      }\n    ]\n  },\n  \"iconUrl\": \"data:image/svg+xml;base64,\"\n}"
