# Secrets and config files containing credentials
oauath_config
deploy/auth.cred
*.cred
*.credentials
*.token
**/hugging_face.token

# Terraform: state holds generated passwords in plaintext; tfvars holds project IDs
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log


# Environment files
.env
.env.*
*.env
**/.env
**/.env.*

# Local virtual environments
venv/
.venv/
.env/

# ADK (Agent Development Kit) state and cache
.adk/
**/.adk/
**/session.db

# Python runtime clutter
__pycache__/
*.pyc

# Logs
*.log

# OS-specific files
.DS_Store
**/.DS_Store

# Git backups
.git_backup/
**/.git_backup/

# Large datasets and exports (>100MB)
journals/
**/*.xlsx
massive_stock_data/*.csv
